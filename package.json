{
	"name": "@tensquads/ui",
	"version": "0.1.0",
	"description": "Shared UI components for tensquads and بنّاء",
	"license": "MIT",
	"type": "module",
	"files": [
		"packages/ui/dist/**"
	],
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"node": "26.x",
		"npm": "11.x"
	},
	"packageManager": "npm@11.20.0",
	"exports": {
		"./tokens": {
			"types": "./packages/ui/dist/tokens/index.d.ts",
			"import": "./packages/ui/dist/tokens/index.js"
		},
		"./tokens.css": "./packages/ui/dist/tokens/tokens.css",
		"./styles.css": "./packages/ui/dist/styles/styles.css",
		"./fonts.css": "./packages/ui/dist/fonts.css",
		"./react": {
			"types": "./packages/ui/dist/react/index.d.ts",
			"import": "./packages/ui/dist/react/index.js"
		},
		"./squadmates": {
			"types": "./packages/ui/dist/squadmates/index.d.ts",
			"import": "./packages/ui/dist/squadmates/index.js"
		},
		"./openui": {
			"types": "./packages/ui/dist/openui/index.d.ts",
			"import": "./packages/ui/dist/openui/index.js"
		},
		"./openui/server": {
			"types": "./packages/ui/dist/openui/server/index.d.ts",
			"import": "./packages/ui/dist/openui/server/index.js"
		},
		"./openui/server/anthropic": {
			"types": "./packages/ui/dist/openui/server/anthropic.d.ts",
			"import": "./packages/ui/dist/openui/server/anthropic.js"
		},
		"./schemas": {
			"types": "./packages/ui/dist/schemas/index.d.ts",
			"import": "./packages/ui/dist/schemas/index.js"
		}
	},
	"scripts": {
		"preview:install": "npm --prefix apps/preview ci",
		"dev": "npm --prefix apps/preview run dev",
		"build:preview": "npm --prefix apps/preview run build",
		"deploy:preview": "npm --prefix apps/preview run deploy",
		"check:preview": "npm --prefix apps/preview run check",
		"e2e": "playwright test",
		"build": "node scripts/build.mjs",
		"prepare": "npm run build",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"check:pack": "node scripts/check-pack.mjs",
		"ui-sdk:update": "node scripts/ui-sdk-update.mjs",
		"check:ui-sdk-usage": "node scripts/check-ui-sdk-usage.mjs",
		"check:git-install": "node scripts/check-git-install.mjs",
		"design:check": "node scripts/design-check.mjs",
		"design:sync": "node scripts/sync-design.mjs",
		"check": "biome check . && npm run typecheck && npm run design:check && npm run tokens:check && npm run docs:check && npm run check:css-tokens && npm run check:ui-sdk-usage && npm run test && npm run check:pack",
		"check:css-tokens": "node scripts/check-css-tokens.mjs",
		"verify": "npm run check && npm run preview:install && npm run check:preview && npm run e2e",
		"tokens": "node scripts/build-tokens.mjs",
		"tokens:check": "node scripts/build-tokens.mjs --check",
		"docs": "node scripts/build-llms.mjs",
		"docs:check": "node scripts/build-llms.mjs --check"
	},
	"dependencies": {
		"@openuidev/lang-core": "1.1.1",
		"@openuidev/react-lang": "1.1.1",
		"@ui-sdk/core": "0.1.0-beta.10",
		"@ui-sdk/react": "0.1.0-beta.10",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"@anthropic-ai/sdk": "1.10.0",
		"react": ">=19.0.0 <20",
		"react-dom": ">=19.0.0 <20"
	},
	"peerDependenciesMeta": {
		"@anthropic-ai/sdk": {
			"optional": true
		}
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "1.10.0",
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "2.6.4",
		"@playwright/test": "1.64.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"jsdom": "31.0.1",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	}
}
