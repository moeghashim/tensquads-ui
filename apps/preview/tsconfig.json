{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["vite/client", "node", "vitest/globals"],
		"paths": {
			"@tensquads/ui/tokens.css": ["../../packages/ui/src/tokens/tokens.css"],
			"@tensquads/ui/styles.css": ["../../packages/ui/src/styles/styles.css"],
			"@tensquads/ui/*": ["../../packages/ui/src/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
