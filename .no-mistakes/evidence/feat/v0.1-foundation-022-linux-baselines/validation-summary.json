  "configuration": {
    "PR_events": {
      "types": [
        "opened",
        "synchronize",
        "reopened"
      ]
    },
    "push": {
      "branches": [
        "main",
        "feat/v0.1-foundation"
      ]
    },
    "dispatch": {
      "inputs": {
        "branch": {
          "description": "Branch to verify",
          "required": true,
          "type": "string"
        }
      }
    },
    "concurrency": {
      "group": "ci-${{ github.event.pull_request.number || inputs.branch || github.ref }}",
      "cancel-in-progress": true
    },
    "checkout": {
      "ref": "${{ inputs.branch || github.event.pull_request.head.sha || github.sha }}",
      "fetch-depth": 0
    },
    "commit_resolution": {
      "name": "Resolve checked-out commit",
      "id": "checkout-commit",
      "run": "echo \"sha=$(git rev-parse HEAD)\" >> \"$GITHUB_OUTPUT\""
    },
    "git_install_environment": {
      "GITHUB_SHA": "${{ steps.checkout-commit.outputs.sha }}"
    },
    "screenshot_upload": {
      "name": "Upload screenshots",
      "if": "always()",
      "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
      "with": {
        "name": "screenshots",
        "path": "test-results/screenshots/",
        "if-no-files-found": "ignore",
        "retention-days": 14
      }
    },
    "gate_test_command": "mise exec -- npm run verify"
  },
  "limits": "Workflow configuration was parsed semantically. Remote workflow triggering, cancellation, artifact retention and outer gate execution belong to the outer executor; they were not executed here.",
  "visual_review": [
    "en-ltr-light-1440.png: gallery component names and controls visible",
    "ar-rtl-dark-390.png: RTL mobile gallery wraps within viewport",
    "menu-ar-rtl-dark-390.png: full-page open popup and fixture visible"
  ],
  "setup": {
    "initial_mise_attempt": "exit 1: untrusted worktree configuration; resolved using MISE_TRUSTED_CONFIG_PATHS=$PWD without changing user configuration",
    "npm_ci_exit": 0,
    "preview_install_exit": 0
  },
  "command": "MISE_TRUSTED_CONFIG_PATHS=\"$PWD\" PLAYWRIGHT_HTML_OPEN=never PLAYWRIGHT_HTML_OUTPUT_DIR=~/.no-mistakes/evidence/01M7Q2F1XN6CP1Y0AVAM7GRTWN/playwright-report mise exec -- npm run e2e -- e2e/preview.spec.ts e2e/badge.spec.ts e2e/button.spec.ts e2e/input-field.spec.ts e2e/menu.spec.ts e2e/squadmate.spec.ts e2e/openui/fixtures.spec.ts --workers=2 --reporter=html,line --output=~/.no-mistakes/evidence/01M7Q2F1XN6CP1Y0AVAM7GRTWN/playwright-results"
}
