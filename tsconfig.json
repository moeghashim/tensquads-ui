{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node", "vitest/globals"]
	},
	"include": ["packages/ui/src/**/*.ts", "packages/ui/src/**/*.tsx", "scripts/**/*.mjs", "scripts/**/*.tsx", "vitest.config.ts"]
}
